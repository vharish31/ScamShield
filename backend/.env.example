# ==============================================================================
# Scam Shield - Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Path to Firebase Admin SDK Service Account JSON credentials
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Maximum allowable audio upload size in Megabytes
MAX_AUDIO_SIZE_MB=25

# Directory for temporary audio processing
UPLOAD_DIRECTORY=uploads

# Faster-Whisper model size (options: tiny, base, small, medium, large-v3)
# 'tiny' or 'base' is recommended for initial development and CPU usage
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Application Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Optional Machine Learning Model Integration
# Configure when your teammate delivers the trained model artifacts
ML_MODEL_ENABLED=False
ML_MODEL_PATH=models/artifacts/scam_classifier.joblib
ML_VECTORIZER_PATH=models/artifacts/vectorizer.joblib

# Notification Service Configuration
NOTIFICATION_ENABLED=False
NOTIFICATION_DRY_RUN=True

# Development Authentication Bypass (Set to True only for local testing without Firebase)
ALLOW_DEV_AUTH_BYPASS=False

